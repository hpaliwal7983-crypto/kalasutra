# Server-side free text AI provider. Add a real key in Render Environment.
# Never commit real credentials. OpenRouter powers text chat/copilot only.
OPENROUTER_API_KEY=
# Optional; defaults to OpenRouter's free-model router.
# KALASUTRA_OPENROUTER_MODEL=openrouter/free

# Optional OpenAI key for Realtime voice and cloud transcription/TTS.
# Browser speech recognition/synthesis remain the no-card fallback.
OPENAI_API_KEY=

# Optional AI service configuration; defaults are documented in AI-KEY-SETUP.txt.
# KALASUTRA_AI_MODEL=
# KALASUTRA_REALTIME_MODEL=
# KALASUTRA_TRANSCRIBE_MODEL=
# KALASUTRA_TTS_MODEL=
# KALASUTRA_TTS_VOICE=

RAZORPAY_KEY_ID=rzp_test_your_key_id
RAZORPAY_KEY_SECRET=your_secret_key
